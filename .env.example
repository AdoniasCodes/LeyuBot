# When running functions locally with the emulator, you need to provide credentials.
# 1. Go to your Firebase project settings > Service accounts.
# 2. Click "Generate new private key". A JSON file will be downloaded.
# 3. Save this file somewhere safe on your computer (e.g., outside your project folder).
# 4. Create a `.env` file by copying this example file.
# 5. Add the full path to your downloaded JSON key file to the .env file.
#    Example for Windows: GOOGLE_APPLICATION_CREDENTIALS="C:\Users\YourUser\keys\service-account.json"
#    Example for macOS/Linux: GOOGLE_APPLICATION_CREDGENTIALS="/home/user/keys/service-account.json"

GOOGLE_APPLICATION_CREDENTIALS=""

# --- Firebase (public) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# --- cPanel uploader (server-side) ---
# CPANEL_UPLOAD_URL must point to your cPanel PHP endpoint for file uploads
CPANEL_UPLOAD_URL=https://files.leyubus.com/api/upload-handler.php
# Define the token in your local .env.local and Vercel Project Settings; do NOT commit real values
CPANEL_UPLOAD_TOKEN=

# --- SMTP (server-side) ---
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_FROM=

# --- AI Providers (server-side) ---
GEMINI_API_KEY=

# --- Misc ---
GITHUB_TOKEN=
